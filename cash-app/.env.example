# Server-side secrets: configure these in Vercel Project Settings, never in the Expo bundle.
DATABASE_URL=
E2B_API_KEY=
E2B_TEMPLATE=base
E2B_TIMEOUT_MS=120000
E2B_EXECUTION_TIMEOUT_MS=30000

# Leave empty for same-origin web deployment; set the public Vercel URL for native builds.
EXPO_PUBLIC_AGENT_API_URL=
